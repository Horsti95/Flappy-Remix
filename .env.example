# Public — exposed to the browser bundle. Use the anon key from Supabase.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Server-only — used by Vercel edge/serverless functions for privileged
# operations (validating runs, generating skin unlocks). NEVER expose
# this with a VITE_ prefix.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: explicit public site URL for OG image absolute paths
PUBLIC_SITE_URL=http://localhost:5173

# Monetisation (ethics-aligned — see ETHICS.md "Making it sustainable").
# All optional; sensible placeholders apply if unset.
# Tip link — use a platform ALIAS (Buy Me a Coffee / Ko-fi / GitHub
# Sponsors), never a personal PayPal/email, to avoid doxxing.
VITE_SUPPORT_URL=https://buymeacoffee.com/hossi95
# The banner slot (top of the app shell, hidden during a run). Reserved for a
# real ad banner at launch; today it renders one static message you control.
# Set ENABLED=false to hide it entirely. The built-in default is a deliberate
# placeholder in-joke; override it here per-deploy.
# See src/game/support.ts for what switching this to Google AdSense requires
# (ETHICS.md/PRIVACY.md rewrite, an EEA consent CMP, and a CSP change).
VITE_BANNER_ENABLED=true
VITE_BANNER_LABEL=100,000 EUR to advertise to his friends and family only
# VITE_BANNER_HREF=https://example.com

# In-app feedback (Settings → send feedback). The form POSTs to /api/feedback,
# which files a GitHub issue server-side; when that endpoint isn't configured
# (or the player is signed out) the UI falls back to opening VITE_FEEDBACK_URL
# (defaults to the public repo's new-issue page).
# VITE_FEEDBACK_URL=https://github.com/OWNER/REPO/issues/new
# Server-only, for /api/feedback: fine-grained PAT with issues:write scope.
# GITHUB_FEEDBACK_TOKEN=github_pat_...
# GITHUB_FEEDBACK_REPO=owner/repo
