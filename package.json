{
  "name": "glide",
  "private": true,
  "version": "0.25.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "backup": "node scripts/backup.mjs",
    "smoke": "node scripts/smoke-browser.mjs",
    "test:migrations": "./scripts/test-migrations.sh",
    "migration:bundle": "node scripts/build-combined-migration.mjs -o migration-bundle.sql",
    "preflight": "node scripts/preflight.mjs",
    "migrate": "node scripts/apply-migrations.mjs",
    "migrate:verify": "node scripts/apply-migrations.mjs --verify-only"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "autoprefixer": "^10.4.20",
    "pg": "^8.23.0",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/og": "^0.11.1"
  }
}
